[Unit]
Description=message-mix calibnet update, once a day

[Timer]
# Midnight, or at boot if the host was down then. The services wait for the node to sync and run
# one after another: sector-spiegel, message-mix, fil-release.
OnCalendar=daily
Persistent=true
Unit=message-mix@calibnet.service

[Install]
WantedBy=timers.target
